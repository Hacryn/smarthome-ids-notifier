#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Static IP (optional, alternative to DHCP). Leave STATIC_IP_ENABLED as
// false to keep using DHCP as before. If enabled but IP/gateway/subnet/DNS1
// are missing or not valid dotted-decimal addresses, the firmware logs a
// warning and falls back to DHCP - it never starts with a half-applied
// static configuration.
#define STATIC_IP_ENABLED false
#define STATIC_IP_ADDRESS "192.168.1.50"
#define STATIC_IP_GATEWAY "192.168.1.1"
#define STATIC_IP_SUBNET "255.255.255.0"
#define STATIC_IP_DNS1 "192.168.1.1"
#define STATIC_IP_DNS2 ""  // optional, leave empty to configure only one DNS server

#define TELEGRAM_BOT_TOKEN "123456789:AAExampleTokenReplaceMe"

// chat_id iniziale, promosso automaticamente ad admin al primo avvio (sez. 4.5)
#define ONBOARDING_CHAT_ID 111111111LL
